# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Sanity CMS Configuration
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-01-01

# Feature Flags
VITE_USE_SANITY=false

# Optional: Sanity Token (only needed for mutations/writes)
# VITE_SANITY_TOKEN=

# Google Services (if applicable)
# VITE_GOOGLE_REVIEWS_URL=
# VITE_GOOGLE_WRITE_REVIEW_URL=
# VITE_TRIPADVISOR_REVIEWS_URL=
# VITE_FACEBOOK_REVIEWS_URL=

# Analytics (if using)
# VITE_GA_TRACKING_ID=
# VITE_GTM_ID=
