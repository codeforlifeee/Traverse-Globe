{
  "name": "traverse-globe-sanity",
  "version": "1.0.0",
  "private": true,
  "description": "Sanity Studio for Traverse Globe",
  "main": "package.json",
  "scripts": {
    "dev": "node -r dotenv/config ./node_modules/.bin/sanity dev",
    "start": "node -r dotenv/config ./node_modules/.bin/sanity start",
    "build": "node -r dotenv/config ./node_modules/.bin/sanity build",
    "vercel-build": "node -r dotenv/config ./node_modules/.bin/sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/vision": "^4.19.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sanity": "^4.19.0",
    "styled-components": "^6.1.0"
  },
  "engines": {
    "node": "20.x"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^3.0.1",
    "eslint": "^8.6.0",
    "prettier": "^3.0.2",
    "dotenv": "^16.0.0"
  }
}
